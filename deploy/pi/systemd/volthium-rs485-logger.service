[Unit]
Description=Volthium battery RS-485 logger (writes data/pack.csv over the wire)
# No bluetooth dependency — this is the wired path. Mutually exclusive with
# volthium-logger.service (both write data/pack.csv); run exactly one.
Conflicts=volthium-logger.service
After=network.target

[Service]
Type=simple
User=claude
Group=users
# UMask so the shared group actually works. WHY: on 2026-10-04 the primary
# telemetry logger crash-looped 593 times over 70 minutes with
# "PermissionError: data/pack.csv". Cause: these services run as `claude` with
# the default umask 0022, so every file they create is 0644 — group-readable
# but NOT group-writable. The moment anything running as `kaan` (an operator
# SSH session, an ad-hoc diagnostic) recreated pack.csv, it came back
# kaan:users 0644 and `claude` could never append again. The common group
# `users` was supposed to make the two interchangeable; umask 0022 quietly
# made it decorative. 0002 keeps new files 0664 so either side can write what
# the other created. Pair with the setgid bit on data/ (see deploy/pi/README).
UMask=0002
SupplementaryGroups=dialout
WorkingDirectory=/srv/volthium_reader
# Events go to the same log the BLE logger used, so the events uploader is unchanged.
Environment=VOLTHIUM_BLE_EVENT_LOG=/srv/volthium_reader/data/ble_events.jsonl
ExecStart=/srv/volthium_reader/.venv/bin/python scripts/rs485_log.py \
  --a-port /dev/ttyRS485-a --b-port /dev/ttyRS485-b \
  --interval 5 --csv data/pack.csv --log data/pack.log
# Telemetry is the mission: never let a rogue memory hog (e.g. an ad-hoc
# analysis job) get this OOM-killed ahead of itself. See CLAUDE.md and the
# 2026-07-26 outage — a heavy job on this 1 GB Pi took telemetry down.
OOMScoreAdjust=-900
# BOUND THE MEMORY. Left at `infinity` when the newer services were capped
# on 2026-08-09 — an inconsistency, not a decision. This is the PRIMARY telemetry source — every reading in the database comes through here.
#
# On a 1 GB box with ~100 MB of swap, an uncapped process is the shape of the
# 2026-07-26 outage (CLAUDE.md rule 1): something grows, the box thrashes, and
# telemetry and SSH go with it for however many weeks until someone drives out.
# A cap converts that into "restarts and loses a few seconds", which
# Restart=always already handles.
#
# 128M against an observed steady state of ~22 MB is deliberately generous;
# the point is a ceiling, not a diet. MemorySwapMax=0 because on ~100 MB of
# swap, a process allowed to swap kills the box slowly instead of dying fast.
MemoryMax=128M
MemorySwapMax=0
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
