[Unit]
Description=Volthium Xanbus (CAN) raw capture
After=network.target

[Service]
Type=simple
# Runs as root: brings up can0 and opens a raw AF_CAN socket (CAP_NET_RAW).
WorkingDirectory=/srv/volthium_reader
# Bring up can0 @ 250 kbit/s (Xanbus). '-' on the down line ignores
# "not up yet"; the reconfigure needs the link down first.
#
# listen-only is OFF as of 2026-08-05 so scripts/xanbus_write.py can issue
# the MPPT Standby->Operating bounce that clears a diode-clamp latch (the
# failure that cost five days of regulated charging; see
# docs/xanbus-decode.md). Nothing on this box transmits on its own: the
# capture and telemetry services only ever read, and the writer refuses to
# send without an explicit --send flag.
#
# TO REVERT (restores a bus we physically cannot transmit on):
#   change 'listen-only off' back to 'listen-only on' here, then
#   sudo systemctl restart volthium-xanbus-capture
# NOTE: bus-off auto-recovery is NOT available here — this gs_usb adapter
# rejects 'restart-ms' with "Device doesn't support restart from Bus Off"
# (learned the hard way 2026-08-05: it fails the whole ExecStartPre and
# leaves can0 down). So a bus-off from a bad TX needs a manual
# 'ip link set can0 down/up' over SSH, or a service restart. Keep that in
# mind before transmitting; scripts/can_watchdog.sh automates the recovery.
ExecStartPre=-/sbin/ip link set can0 down
ExecStartPre=/sbin/ip link set can0 type can bitrate 250000 listen-only off
ExecStartPre=/sbin/ip link set can0 up
ExecStart=/srv/volthium_reader/.venv/bin/python scripts/can_capture.py
# BOUND THE MEMORY. This was `infinity` until 2026-08-09, and at 57 MB after
# 82 h uptime it is the largest of the six services by 4x — uncapped, on a
# 1 GB box with ~100 MB of swap. That is exactly the shape of the 2026-07-26
# outage (CLAUDE.md rule 1): a process grows, the box thrashes, telemetry and
# SSH go with it, and nobody can reach the site for weeks.
#
# 200M is deliberately generous — 3.5x the observed steady state — because the
# point is not to trim it, it is to convert "eats the Pi" into "restarts and
# loses a few seconds of capture". Raw capture is a decode corpus, not the
# mission; losing some is survivable, losing the box is not.
#
# MemorySwapMax=0 for the same reason it is set on the telemetry unit: on
# ~100 MB of swap, a process allowed to swap takes the whole box down slowly
# instead of dying quickly.
MemoryMax=200M
MemorySwapMax=0
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
