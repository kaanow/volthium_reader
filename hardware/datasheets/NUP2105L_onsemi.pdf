            xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/">
         <pdf:Producer>Acrobat Distiller 26.0 (Windows)</pdf:Producer>
         <pdf:Keywords/>
         <xmp:CreatorTool>BroadVision, Inc.</xmp:CreatorTool>
         <xmp:ModifyDate>2026-06-12T09:19:07-07:00</xmp:ModifyDate>
         <xmp:CreateDate>2026-06-12T09:09:35-07:00</xmp:CreateDate>
         <xmp:MetadataDate>2026-06-12T09:19:07-07:00</xmp:MetadataDate>
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NUP2105L - ESD Protection Diode / 27 V Dual Line CAN Bus Protector</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The SZ/NUP2105L has been designed to protect the CAN&#xA;transceiver in high-speed and fault tolerant networks from ESD and&#xA;other harmful transient voltage events. This device provides&#xA;bidirectional protection for each data line with a single compact&#xA;SOT-23 package, giving the system designer a low cost option for&#xA;improving system reliability and meeting stringent EMI requirements.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:2655dbd2-3d77-48ae-984e-59fc8552ad2e</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:869aef38-b603-4880-8f66-451418857fc7</xmpMM:InstanceID>
      </rdf:Description>
   </rdf:RDF>
